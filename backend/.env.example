# Google Gemini API Key (Required only if MOCK_AI=false)
GEMINI_API_KEY=

# Mock AI Mode: Set to true to use deterministic sample findings without calling Gemini
MOCK_AI=true

# Gemini model identifier (used when MOCK_AI=false)
GEMINI_MODEL=gemini-2.5-flash

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Maximum file upload size in bytes (10 MB default)
MAX_IMAGE_SIZE_BYTES=10485760

# JWT Authentication Secret
JWT_SECRET=your_secure_jwt_secret_key_change_in_production

# Location-Aware Dentist Search Provider (Optional: Google Places API or custom provider)
# If left blank, real global OpenStreetMap / Nominatim live dentist search is used automatically
DENTIST_API_KEY=
DENTIST_API_URL=
